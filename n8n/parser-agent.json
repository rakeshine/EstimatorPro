        "jsCode": "return {\n  model: \"phi-3-mini-4k-instruct\",\n  messages: [\n    {\n      role: \"system\",\n      content: `\nYou are a senior business analyst.\nYou MUST ALWAYS respond in STRICT VALID JSON.\nNo markdown. No explanation outside JSON.\nIf any section cannot be extracted, return an empty string for that field.\n`\n    },\n    {\n      role: \"user\",\n      content:\n        \"Extract the following from the provided RFP text:\\n\\n\" +\n        \"1. A concise summary (5–8 lines)\\n\" +\n        \"2. Functional requirements (bulleted text, string)\\n\" +\n        \"3. Non-functional requirements (bulleted text, string)\\n\\n\" +\n\n        \"Rules:\\n\" +\n        \"- Summary must be 5–8 lines (not bullets, not paragraphs).\\n\" +\n        \"- Functional requirements must be true functional needs only.\\n\" +\n        \"- Non-functional requirements must include items related to security, performance, scalability, availability, integration, compliance.\\n\" +\n        \"- Keep bullets as a single string with each item on a new line.\\n\" +\n        \"- Maintain a neutral tone.\\n\" +\n        \"- If information is unclear or missing, return \\\"\\\" for that field.\\n\" +\n        \"- Output MUST match the schema exactly.\\n\\n\" +\n\n        \"Respond STRICTLY in valid JSON:\\n\" +\n        `{\n  \"summary\": \"string\",\n  \"functionalRequirements\": \"string\",\n  \"nonFunctionalRequirements\": \"string\"\n}` +\n        \"\\n\\n\" +\n        \"RFP Text:\\n\" +\n        $json.data\n    }\n  ]\n};\n"
      },
