    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  model: \"phi-3-mini-4k-instruct\",\n  messages: [\n    {\n      role: \"system\",\n      content: `\nYou are a senior product/business analyst.\nYou MUST ALWAYS respond in STRICT VALID JSON — nothing else.\nYour output must contain:\n- NO markdown\n- NO explanations\n- NO comments\n- NO text before or after the JSON\n- NO trailing commas\n- NO missing keys\nIf you are unsure, output an empty array [].\n`\n    },\n    {\n      role: \"user\",\n      content:\n        \"Break the following EPIC into FEATURES.\\n\\n\" +\n        \"1. Epic Title:\\n\" +\n        $json.epicTitle + \"\\n\\n\" +\n        \"2. Epic Description:\\n\" +\n        $json.epicDescription + \"\\n\\n\" +\n        \"3. Additional Instructions:\\n\" +\n        $json.additionalInstructions + \"\\n\\n\" +\n        \"FEATURE RULES:\\n\" +\n        \"- Produce 4–10 features for the epic.\\n\" +\n        \"- Each feature must be independent, business-focused, non-technical.\\n\" +\n        \"- Descriptions must be 1–3 concise sentences.\\n\" +\n        \"- Do NOT include user stories, acceptance criteria, or tasks.\\n\" +\n        \"- Do NOT copy the epic text; rewrite concisely.\\n\\n\" +\n        \"OUTPUT RULES:\\n\" +\n        \"- Respond ONLY with valid JSON.\\n\" +\n        \"- JSON MUST be an array.\\n\" +\n        \"- Each item MUST conform to this strict schema:\\n\" +\n        `[\n  {\n    \"featureTitle\": \"string\",\n    \"featureDescription\": \"string\"\n  }\n]` +\n        \"\\n\" +\n        \"If the JSON is invalid, the entire output is considered incorrect.\"\n    }\n  ]\n};\n"
      },
