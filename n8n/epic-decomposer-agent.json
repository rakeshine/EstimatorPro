        "jsCode": "return {\n  model: \"phi-3-mini-4k-instruct\",\n  messages: [\n    {\n      role: \"system\",\n      content: `\nYou are a senior solution architect.\nYou must ALWAYS respond with STRICT, VALID JSON with no additional text.\nIf you are unsure, output an empty array [].\nJSON must be minified or pretty-printed, but MUST NOT contain:\n- comments\n- trailing commas\n- explanations\n- markdown formatting\nOnly output pure JSON.\n`\n    },\n    {\n      role: \"user\",\n      content:\n        \"Break the given requirements into EPICS. Refer to summary for context and additional information for more detail.\\n\\n\" +\n        \"1. Functional Requirements:\\n\" +\n        $json.functionalRequirements + \"\\n\\n\" +\n        \"2. Non-Functional Requirements:\\n\" +\n        $json.nonFunctionalRequirements + \"\\n\\n\" +\n        \"3. Summary:\\n\" +\n        $json.summary + \"\\n\\n\" +\n        \"4. Additional Instructions:\\n\" +\n        $json.additionalInstructions + \"\\n\\n\" +\n        \"EPIC RULES:\\n\" +\n        \"- Combine related requirements.\\n\" +\n        \"- Produce 5–12 well-defined epics.\\n\" +\n        \"- Epic description must be 2–4 sentences.\\n\" +\n        \"- Do NOT go into feature-level details.\\n\" +\n        \"- Do NOT repeat the user's text.\\n\" +\n        \"- Do NOT generate features.\\n\\n\" +\n        \"OUTPUT RULES:\\n\" +\n        \"- Respond ONLY with valid JSON.\\n\" +\n        \"- JSON must be an array of objects.\\n\" +\n        \"- Each object MUST follow this schema:\\n\" +\n        `[\n  {\n    \"epicTitle\": \"string\",\n    \"epicDescription\": \"string\"\n  }\n]`\n    }\n  ]\n};\n"
      },
