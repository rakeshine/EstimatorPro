    {
      "parameters": {
        "jsCode": "function extractCleanRFPSections(input) {\n  const clean = {};\n\n  // ------------------ SUMMARY ------------------\n  const summaryMatch = input.match(/\"summary\"\\s*:\\s*\"([^\"]*)\"/s);\n  clean.summary = summaryMatch ? summaryMatch[1].trim() : \"\";\n\n  // ------------------ FUNCTIONAL REQUIREMENTS ------------------\n  const frMatch = input.match(/\"functionalRequirements\"\\s*:\\s*\\[([\\s\\S]*?)\\]/);\n  if (frMatch) {\n    const frItems = frMatch[1]\n      .split(\"\\n\")\n      .map(line => line.replace(/\"|,|\\]/g, \"\").trim())\n      .filter(line => line.length > 0 && !line.includes(\":\"));\n\n    // Convert array → bullet-point string\n    clean.functionalRequirements = frItems.length\n      ? frItems.map(i => `• ${i}`).join(\"\\n\")\n      : \"\";\n  } else {\n    clean.functionalRequirements = \"\";\n  }\n\n  // ------------------ NON-FUNCTIONAL REQUIREMENTS ------------------\n  const nfrMatch = input.match(/\"nonFunctionalRequirements\"\\s*:\\s*\\[([\\s\\S]*?)\\]/);\n  if (nfrMatch) {\n    const nfrItems = nfrMatch[1]\n      .split(\"\\n\")\n      .map(line => line.replace(/\"|,|\\]/g, \"\").trim())\n      .filter(line => line.length > 0 && !line.includes(\":\"));\n\n    clean.nonFunctionalRequirements = nfrItems.length\n      ? nfrItems.map(i => `• ${i}`).join(\"\\n\")\n      : \"\";\n  } else {\n    clean.nonFunctionalRequirements = \"\";\n  }\n\n  return clean;\n}\n\nconst messyJson = $input.first().json.choices[0].message.content;\n\nreturn [\n  {\n    \"json\": extractCleanRFPSections(messyJson)\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -576
      ],
      "id": "db4e9f24-bf3a-447d-b22e-fd77289ff52d",
      "name": "Extract Summary"
    },
    {
      "parameters": {
        "jsCode": "function extractEpics(input) {\n  const epics = [];\n\n  // Regex to capture each epic block\n  const epicRegex = /\"epicTitle\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"epicDescription\"\\s*:\\s*\"([^\"]*)\"/g;\n\n  let match;\n  while ((match = epicRegex.exec(input)) !== null) {\n    epics.push({\n      epicTitle: match[1].trim(),\n      epicDescription: match[2].trim(),\n    });\n  }\n\n  return epics;\n}\n\nconst messyJson = $input.first().json.choices[0].message.content;\n\nreturn extractEpics(messyJson);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        -576
      ],
      "id": "59f1d7fe-4320-4f20-a005-92c7fd23909d",
      "name": "Extract Epics"
    },
    {
      "parameters": {
        "jsCode": "function extractFeatures(input) {\n  const features = [];\n\n  // Regex to capture each feature block\n  const featureRegex = /\"featureTitle\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"featureDescription\"\\s*:\\s*\"([^\"]*)\"/g;\n\n  let match;\n  while ((match = featureRegex.exec(input)) !== null) {\n    features.push({\n      featureTitle: match[1].trim(),\n      featureDescription: match[2].trim(),\n    });\n  }\n\n  return features;\n}\n\nconst messyJson = $input.first().json.choices[0].message.content;\n\nreturn extractFeatures(messyJson);\n"
      },
